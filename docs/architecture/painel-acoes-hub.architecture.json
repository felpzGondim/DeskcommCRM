{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Ações do painel do agente e Brisa Hub",
    "subtitle": "Consulta com identidade da conversa e análise confirmada",
    "output": "painel-acoes-hub.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "inbox",
      "label": "Inbox"
    },
    {
      "id": "servidor",
      "label": "Servidor"
    },
    {
      "id": "integracao",
      "label": "Integração"
    },
    {
      "id": "registro",
      "label": "Registro"
    }
  ],
  "mainPath": [
    "botoes",
    "rota",
    "mcp",
    "hub"
  ],
  "nodes": [
    {
      "id": "botoes",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "PainelDoAgente: resumo + Abrir análise"
    },
    {
      "id": "rota",
      "lane": "servidor",
      "col": 2,
      "type": "route",
      "label": "painel-agente/acoes: agent+, org, rate limit"
    },
    {
      "id": "mcp",
      "lane": "integracao",
      "col": 3,
      "type": "process",
      "label": "Cliente MCP externo: tools/list e tools/call"
    },
    {
      "id": "hub",
      "lane": "integracao",
      "col": 4,
      "type": "external",
      "label": "Brisa Hub: boletos, contrato (status/encontrado), ficha, busca de pessoas e análise"
    },
    {
      "id": "audit",
      "lane": "registro",
      "col": 3,
      "type": "database",
      "label": "api_audit_log: ação, sucesso técnico e status do contrato, sem PII"
    },
    {
      "id": "recibo",
      "lane": "registro",
      "col": 3,
      "type": "database",
      "label": "idempotency_keys: conversa + pedido"
    },
    {
      "id": "composer",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "Composer: texto sugerido para revisão humana"
    },
    {
      "id": "anexos",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "Leitura documental: PDF, OCR/visão e senha"
    },
    {
      "id": "aviso_teto",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "Marca derivado no teto de 8000; não infere ausência"
    },
    {
      "id": "visao",
      "lane": "integracao",
      "col": 3,
      "type": "external",
      "label": "Ponto visao_de_imagem (Gemini do painel)"
    },
    {
      "id": "storage",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "whatsapp-media: original e URL assinada curta"
    },
    {
      "id": "ficha_botao",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "Gerar relatório preliminar e correção da ficha"
    },
    {
      "id": "ficha_rota",
      "lane": "servidor",
      "col": 2,
      "type": "route",
      "label": "painel-agente/ficha: enfileira gerar ou salva"
    },
    {
      "id": "ficha_fila",
      "lane": "registro",
      "col": 3,
      "type": "database",
      "label": "event_log: painel.relatorio_preliminar_requested"
    },
    {
      "id": "ficha_worker",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "worker: painel-relatorio-preliminar"
    },
    {
      "id": "ficha_tabela",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "locacao_fichas_preliminares: versão, quem, caminhos"
    },
    {
      "id": "extrato",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "Extrato: terceiros na renda, familiares e tabela mensal"
    },
    {
      "id": "analise_modal",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "Modal Análise de inquilino: Dados, renda, FC, Migra, contrato"
    },
    {
      "id": "pessoa_id",
      "lane": "integracao",
      "col": 3,
      "type": "process",
      "label": "Cabeçalho opcional de pessoa Superlógica (1–12 dígitos)"
    },
    {
      "id": "busca_rota",
      "lane": "servidor",
      "col": 2,
      "type": "route",
      "label": "POST vinculos/busca: {pesquisa}, nome mascarado, sem CPF no log"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "botoes",
      "to": "rota",
      "label": "consulta ou confirmação explícita"
    },
    {
      "id": "e2",
      "from": "rota",
      "to": "mcp",
      "label": "credencial da organização e contato verificado"
    },
    {
      "id": "e3",
      "from": "mcp",
      "to": "hub",
      "label": "tools/call com identidade e, se anunciado, arquivos"
    },
    {
      "id": "e4",
      "from": "rota",
      "to": "audit",
      "label": "ação e desfecho"
    },
    {
      "id": "e5",
      "from": "rota",
      "to": "recibo",
      "label": "reserva antes da análise"
    },
    {
      "id": "e6",
      "from": "hub",
      "to": "botoes",
      "label": "resumo estruturado ou erro visível"
    },
    {
      "id": "e7",
      "from": "botoes",
      "to": "composer",
      "label": "preenche sugestão; atendente decide envio"
    },
    {
      "id": "e8",
      "from": "rota",
      "to": "anexos",
      "label": "200 mensagens mais recentes"
    },
    {
      "id": "e9",
      "from": "anexos",
      "to": "visao",
      "label": "foto e PDF escaneado"
    },
    {
      "id": "e10",
      "from": "anexos",
      "to": "storage",
      "label": "reabre original do tenant"
    },
    {
      "id": "e11",
      "from": "anexos",
      "to": "botoes",
      "label": "prévia, aviso de senha e limites"
    },
    {
      "id": "e12",
      "from": "storage",
      "to": "hub",
      "label": "URL assinada só se a ferramenta anunciar"
    },
    {
      "id": "e13",
      "from": "ficha_botao",
      "to": "ficha_rota",
      "label": "enfileira gerar ou salva com revisão humana"
    },
    {
      "id": "e14",
      "from": "ficha_worker",
      "to": "anexos",
      "label": "200 mensagens e leitura documental"
    },
    {
      "id": "e15",
      "from": "ficha_rota",
      "to": "ficha_tabela",
      "label": "salvar versão; audit sem valores"
    },
    {
      "id": "e23",
      "from": "ficha_rota",
      "to": "ficha_fila",
      "label": "evento pending; senha só no Redis"
    },
    {
      "id": "e24",
      "from": "ficha_fila",
      "to": "ficha_worker",
      "label": "dreno do worker"
    },
    {
      "id": "e25",
      "from": "ficha_worker",
      "to": "ficha_tabela",
      "label": "nova versão da IA"
    },
    {
      "id": "e26",
      "from": "ficha_rota",
      "to": "ficha_botao",
      "label": "consulta: gerando, pronto ou erro"
    },
    {
      "id": "e16",
      "from": "ficha_tabela",
      "to": "rota",
      "label": "celular do inquilino principal para a FC"
    },
    {
      "id": "e17",
      "from": "ficha_rota",
      "to": "ficha_botao",
      "label": "relatório e ficha editável"
    },
    {
      "id": "e18",
      "from": "anexos",
      "to": "aviso_teto",
      "label": "PDF reaberto ou recorte marcado"
    },
    {
      "id": "e19",
      "from": "aviso_teto",
      "to": "ficha_rota",
      "label": "fontes da ficha com aviso"
    },
    {
      "id": "e20",
      "from": "aviso_teto",
      "to": "botoes",
      "label": "PDF reabre; senão recorte com aviso"
    },
    {
      "id": "e21",
      "from": "anexos",
      "to": "extrato",
      "label": "texto do PDF e número de páginas"
    },
    {
      "id": "e22",
      "from": "extrato",
      "to": "ficha_rota",
      "label": "tabela mensal; declarado não é comprovado"
    },
    {
      "id": "e29",
      "from": "botoes",
      "to": "analise_modal",
      "label": "Abrir análise"
    },
    {
      "id": "e30",
      "from": "analise_modal",
      "to": "ficha_botao",
      "label": "aba Dados: ficha e relatório preliminar"
    },
    {
      "id": "e31",
      "from": "mcp",
      "to": "pessoa_id",
      "label": "contato_superlogica_vinculos.superlogica_pessoa_id quando válido"
    },
    {
      "id": "e32",
      "from": "pessoa_id",
      "to": "hub",
      "label": "toda tools/call da chave CRM"
    },
    {
      "id": "e27",
      "from": "analise_modal",
      "to": "busca_rota",
      "label": "busca inquilino/proprietário na aba Dados"
    },
    {
      "id": "e28",
      "from": "busca_rota",
      "to": "mcp",
      "label": "buscar_pessoas_superlogica só leitura"
    },
    {
      "id": "e33",
      "from": "botoes",
      "to": "ficha_botao",
      "label": "resposta do agente atualiza geração sem apagar edição local"
    }
  ]
}
