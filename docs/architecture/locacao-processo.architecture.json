{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Processo de locação (Fases 3, 3.5 e 3b)",
    "subtitle": "Da conversa ao contrato, desligado por padrão, sem mensagem a contato",
    "output": "locacao-processo.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "inbox", "label": "Inbox e telas" },
    { "id": "servidor", "label": "Servidor" },
    { "id": "registro", "label": "Registro" },
    { "id": "fora", "label": "Fora (só GET / cópia)" }
  ],
  "mainPath": ["painel", "flag", "processo", "etapa"],
  "nodes": [
    { "id": "painel", "lane": "inbox", "col": 1, "type": "frontend", "label": "Painel: resumo + Abrir análise (papel contato)" },
    { "id": "analise_modal", "lane": "inbox", "col": 1, "type": "frontend", "label": "Modal: Dados, Análise de renda, Análise FC, Análise Migra, Relatório, Gerar contrato, Documentos" },
    { "id": "casca_aba", "lane": "inbox", "col": 1, "type": "frontend", "label": "AbaComExecucao: checklist, status, Tentar de novo, hora" },
    { "id": "lista", "lane": "inbox", "col": 1, "type": "frontend", "label": "/app/locacao e detalhe com aprovar/reprovar" },
    { "id": "config", "lane": "inbox", "col": 1, "type": "frontend", "label": "Configurações › Locação: chaves desligadas" },
    { "id": "flag", "lane": "servidor", "col": 2, "type": "process", "label": "organizations.settings.locacao.* e superlogica_vinculo" },
    { "id": "rotas", "lane": "servidor", "col": 2, "type": "route", "label": "/api/v1/locacao: org, RBAC, suporte, Zod" },
    { "id": "processo", "lane": "registro", "col": 3, "type": "database", "label": "locacao_processos + imóveis + pessoas + fichas" },
    { "id": "etapa", "lane": "registro", "col": 3, "type": "database", "label": "9 etapas; contrato_criado; eventos sem PII" },
    { "id": "vinculo", "lane": "registro", "col": 3, "type": "database", "label": "contato_superlogica_vinculos (backfill sem apagar chaves)" },
    { "id": "docs", "lane": "registro", "col": 4, "type": "database", "label": "bucket locacao-processos + locacao_processo_documentos" },
    { "id": "retencao", "lane": "servidor", "col": 2, "type": "process", "label": "cron data-retention: 90d / parado 30d / LGPD INVOKER" },
    { "id": "aprovacao", "lane": "servidor", "col": 2, "type": "process", "label": "só aprovador (ou dono) aprova; atendente reprova com motivo" },
    { "id": "seguro", "lane": "registro", "col": 3, "type": "database", "label": "locacao_analises_seguro: pedido, job, estado, resultado (desligado)" },
    { "id": "chaves4", "lane": "servidor", "col": 2, "type": "process", "label": "locacao.analise.{renda,seguro,fc,relatorio,manual} todas false" },
    { "id": "relatorio", "lane": "inbox", "col": 1, "type": "frontend", "label": "Painel: Gerar/aprovar relatório (6 seções, desligado)" },
    { "id": "hub", "lane": "fora", "col": 4, "type": "external", "label": "Superlógica via Hub: só GET; FC só a pedido, reuso 90d" },
    { "id": "drive", "lane": "fora", "col": 4, "type": "external", "label": "Drive Aluguéis: DESKCOMM_* env, chave desligada, nunca apaga" },
    { "id": "audit", "lane": "registro", "col": 3, "type": "database", "label": "api_audit_log: ação e ids, sem CPF/nome/telefone" },
    { "id": "valores", "lane": "registro", "col": 3, "type": "database", "label": "valores do imóvel no processo: origem e edição" },
    { "id": "camposImovel", "lane": "inbox", "col": 1, "type": "frontend", "label": "CamposImovelProcesso na aba Dados (origem visível)" },
    { "id": "camposLocador", "lane": "inbox", "col": 1, "type": "frontend", "label": "CamposLocador na aba Dados (nome, documento e contato mascarados, origem visível)" },
    { "id": "execucoes", "lane": "registro", "col": 3, "type": "database", "label": "locacao_execucoes: uma linha por aba (fila, progresso, hash, resultado)" }
  ],
  "edges": [
    { "id": "e1", "from": "painel", "to": "flag", "label": "só cria se processos_habilitado" },
    { "id": "e2", "from": "flag", "to": "rotas", "label": "gate por organização" },
    { "id": "e3", "from": "rotas", "to": "processo", "label": "service_role filtra organization_id" },
    { "id": "e4", "from": "processo", "to": "etapa", "label": "avança, cancela, encerra" },
    { "id": "e5", "from": "etapa", "to": "lista", "label": "atendente vê etapa e pessoas" },
    { "id": "e6", "from": "lista", "to": "aprovacao", "label": "aprovar / reprovar com motivo" },
    { "id": "e7", "from": "aprovacao", "to": "etapa", "label": "grava quem e quando, sem PII extra" },
    { "id": "e8", "from": "config", "to": "flag", "label": "admin liga e desliga" },
    { "id": "e9", "from": "flag", "to": "config", "label": "estado visível na hora" },
    { "id": "e10", "from": "rotas", "to": "vinculo", "label": "simular / ligar / desligar" },
    { "id": "e11", "from": "vinculo", "to": "hub", "label": "GET pessoa por telefone, nunca escrita" },
    { "id": "e12", "from": "hub", "to": "vinculo", "label": "só ids; ambíguo vai a revisão" },
    { "id": "e13", "from": "rotas", "to": "docs", "label": "anexo se arquivos_habilitado" },
    { "id": "e14", "from": "docs", "to": "drive", "label": "cron só com flag + JSON e id do Drive" },
    { "id": "e15", "from": "drive", "to": "docs", "label": "ensaio: não copia nesta versão" },
    { "id": "e16", "from": "rotas", "to": "audit", "label": "mutação com efeito" },
    { "id": "e17", "from": "audit", "to": "lista", "label": "histórico de etapa, sem valores" },
    { "id": "e18", "from": "processo", "to": "retencao", "label": "encerrado_em conta os 90 dias" },
    { "id": "e19", "from": "retencao", "to": "processo", "label": "parado 30d vira cancelado/expirado" },
    { "id": "e20", "from": "retencao", "to": "docs", "label": "expurga ficha, hash e arquivo conferido" },
    { "id": "e21", "from": "painel", "to": "lista", "label": "abre o processo da conversa" },
    { "id": "e22", "from": "etapa", "to": "hub", "label": "FC a pedido; reaproveita 90 dias" },
    { "id": "e23", "from": "processo", "to": "seguro", "label": "uma cotação em andamento por processo" },
    { "id": "e24", "from": "seguro", "to": "retencao", "label": "90 dias zera resultado; LGPD zera no locatário" },
    { "id": "e25", "from": "flag", "to": "chaves4", "label": "Fase 4 não liga nada" },
    { "id": "e26", "from": "chaves4", "to": "seguro", "label": "chave seguro desligada: tabela vazia" },
    { "id": "e27", "from": "chaves4", "to": "relatorio", "label": "chave relatorio desligada: botão some" },
    { "id": "e28", "from": "relatorio", "to": "processo", "label": "grava rascunho e aprovação; bloco de renda já calculado" },
    { "id": "e29", "from": "painel", "to": "analise_modal", "label": "Abrir análise mesmo com processos desligados" },
    { "id": "e30", "from": "analise_modal", "to": "rotas", "label": "busca, ligar, desligar, ficha, contrato" },
    { "id": "e31", "from": "analise_modal", "to": "vinculo", "label": "contato_superlogica_vinculos + POST/DELETE vinculos" },
    { "id": "e32", "from": "rotas", "to": "hub", "label": "buscar_pessoas_superlogica {pesquisa}" },
    { "id": "e33", "from": "rotas", "to": "valores", "label": "GET pré-preenche; PATCH manual não é sobrescrito" },
    { "id": "e34", "from": "valores", "to": "hub", "label": "FC/Migra usam os quatro; recusa se faltar" },
    { "id": "e35", "from": "analise_modal", "to": "camposImovel", "label": "aba Dados: aluguel, condomínio, IPTU, seguros" },
    { "id": "e36", "from": "camposImovel", "to": "valores", "label": "atendente edita; origem visível" },
    { "id": "e37", "from": "valores", "to": "camposImovel", "label": "mostra valor e origem de cada campo" },
    { "id": "e38", "from": "processo", "to": "execucoes", "label": "uma execução por aba do processo" },
    { "id": "e39", "from": "execucoes", "to": "docs", "label": "ficha_cadastral em {org}/processos/{id}/ficha_cadastral/" },
    { "id": "e40", "from": "analise_modal", "to": "casca_aba", "label": "cada aba tem botão, checklist e status" },
    { "id": "e41", "from": "casca_aba", "to": "execucoes", "label": "polling / desatualizado pelo hash" },
    { "id": "e42", "from": "execucoes", "to": "casca_aba", "label": "fila, etapa, erro, última execução" },
    { "id": "e43", "from": "analise_modal", "to": "etapa", "label": "mostra a etapa do card, sem mover" },
    { "id": "e44", "from": "execucoes", "to": "relatorio", "label": "renda assíncrona grava 3× e exclusões na ficha" },
    { "id": "e45", "from": "analise_modal", "to": "camposLocador", "label": "aba Dados: locador com selo de origem" },
    { "id": "e46", "from": "vinculo", "to": "camposLocador", "label": "proprietário do vínculo preenche o locador mascarado" },
    { "id": "e47", "from": "hub", "to": "valores", "label": "GET /imovel/pacote: aluguel, condomínio, IPTU; busca por endereço quando falta o id" },
    { "id": "e48", "from": "hub", "to": "camposLocador", "label": "GET /imovel/pacote: proprietário do imóvel, mascarado" },
    { "id": "e49", "from": "camposLocador", "to": "processo", "label": "candidato único ou escolhido grava superlogica_imovel_id" }
  ]
}
