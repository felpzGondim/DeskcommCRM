{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Análise de renda no Painel (PR 4.1)",
    "subtitle": "Botão e chat compartilham iniciarAnaliseDeRenda; fila locacao_execucoes; extrato sem teto de páginas",
    "output": "painel-analise-renda.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "inbox", "label": "Inbox" },
    { "id": "servidor", "label": "Servidor" },
    { "id": "modelo", "label": "Modelo" },
    { "id": "registro", "label": "Registro" }
  ],
  "mainPath": ["botao", "chave", "executar", "fila", "cron", "pdfs", "modelo", "ficha"],
  "nodes": [
    {
      "id": "botao",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "Analisar renda no processo da conversa"
    },
    {
      "id": "pergunta",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "/pergunta: analisar_renda (L) e propor confirmar_renda (S)"
    },
    {
      "id": "config",
      "lane": "inbox",
      "col": 1,
      "type": "frontend",
      "label": "Configurações › Locação: locacao.analise.renda off"
    },
    {
      "id": "chave",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "analiseLigada: processos + analise.renda"
    },
    {
      "id": "rota",
      "lane": "servidor",
      "col": 2,
      "type": "route",
      "label": "painel-agente/renda: agent+, org, rate limit"
    },
    {
      "id": "executar",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "iniciarAnaliseDeRenda: só enfileira; 202 + execucao_id"
    },
    {
      "id": "fila",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "locacao_execucoes renda: na_fila, hash, senhas só no jsonb"
    },
    {
      "id": "cron",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "cron locacao-execucoes: reivindica e processa em blocos"
    },
    {
      "id": "pdfs",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "extrato inteiro em lotes; progresso 'lendo extrato pág. X de N'"
    },
    {
      "id": "modelo",
      "lane": "modelo",
      "col": 3,
      "type": "external",
      "label": "prepararFontesDoRelatorio + extrato; ponto painel_analise só se o parser falhar"
    },
    {
      "id": "regras",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "Regra 3×: aluguel+condomínio+IPTU+incêndio; exclusões à parte"
    },
    {
      "id": "ficha",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "locacao_processo_fichas origem preliminar_ia campo renda"
    },
    {
      "id": "evento",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "evento renda; confirmar grava origem atendente + renda_confirmada_*"
    },
    {
      "id": "trava",
      "lane": "servidor",
      "col": 2,
      "type": "process",
      "label": "exigirRendaConfirmada: botões 2 e 3 recusam sem confirmação"
    },
    {
      "id": "audit",
      "lane": "registro",
      "col": 4,
      "type": "database",
      "label": "api_audit_log: ação e versão, sem valores"
    }
  ],
  "edges": [
    { "id": "e1", "from": "config", "to": "chave", "label": "admin liga; ausente = off" },
    { "id": "e2", "from": "chave", "to": "botao", "label": "off: o botão não aparece" },
    { "id": "e3", "from": "chave", "to": "pergunta", "label": "off: some do ToolSet" },
    { "id": "e4", "from": "botao", "to": "rota", "label": "clique do atendente" },
    { "id": "e5", "from": "pergunta", "to": "executar", "label": "L chama; S só propõe" },
    { "id": "e6", "from": "rota", "to": "executar", "label": "origem botao; GET consulta a execução" },
    { "id": "e7", "from": "executar", "to": "fila", "label": "abre na_fila; não roda OCR no POST" },
    { "id": "e16", "from": "fila", "to": "cron", "label": "reivindica na_fila → processando" },
    { "id": "e17", "from": "cron", "to": "pdfs", "label": "sem teto de páginas; motivo visível" },
    {
      "id": "e8",
      "from": "pdfs",
      "to": "modelo",
      "label": "fontes completas, não o derivado cortado"
    },
    { "id": "e9", "from": "modelo", "to": "regras", "label": "JSON + classificador local" },
    { "id": "e10", "from": "regras", "to": "ficha", "label": "nova versão; campos renda" },
    { "id": "e11", "from": "ficha", "to": "evento", "label": "tipo renda, sem PII" },
    { "id": "e12", "from": "rota", "to": "audit", "label": "mutação com efeito" },
    { "id": "e13", "from": "botao", "to": "evento", "label": "Confirmar renda: clique humano" },
    { "id": "e14", "from": "evento", "to": "trava", "label": "sem confirmação, seguro/FC cinza" },
    { "id": "e15", "from": "trava", "to": "botao", "label": "aviso na tela" }
  ]
}
